<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 like every plugin here: the tracker reads Game.log and a SQLite store, never the
       capture stack, so the Windows TFM the engine needs must not appear. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ItemTrackerPlugin</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ocrx.Sdk" Version="2.8.0" />
    <PackageReference Include="Ocrx.Contracts" Version="2.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Microsoft.Data.Sqlite 10.0.0 pulls SQLitePCLRaw 2.1.11, which carries
         GHSA-2m69-gcr7-jv3q. Pin the bundle forward past the advisory. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- The standalone tracker got these from the ASP.NET shared framework: LogWatchService is a
         BackgroundService and the ingest stack logs through ILogger. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="settings-spec.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ItemTrackerPlugin.Tests" />
  </ItemGroup>

</Project>
