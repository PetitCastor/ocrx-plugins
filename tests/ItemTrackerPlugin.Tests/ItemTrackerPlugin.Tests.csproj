<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0-windows, like the plugin under test, which hosts its own WinForms window. The tests
       stay off the UI: they cover the window's rules, not the window. The fixtures and the
       reliability corpus are read from the source tree (CallerFilePath), not copied beside the assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- ImplicitUsings does not cover Xunit; without this every file needs its own using. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- TickDataBuilder and ReplayHarness; brings Ocrx.Sdk and Ocrx.Contracts transitively. -->
    <PackageReference Include="Ocrx.Sdk.Testing" Version="2.9.0" />
  </ItemGroup>

  <!-- The plugin's WebView2 package reaches here through buildTransitive, WPF reference included;
       dropped for the same reason as in ItemTrackerPlugin.csproj (MSB3277). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ItemTrackerPlugin\ItemTrackerPlugin.csproj" />
  </ItemGroup>

</Project>
